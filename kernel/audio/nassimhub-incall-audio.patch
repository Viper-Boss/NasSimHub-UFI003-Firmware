+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * In-call record / playback pseudo ports (NasSimHub UFI003).
+ *
+ * The DSP exposes the downlink and uplink of an ongoing call on pseudo AFE
+ * ports 0x8003 / 0x8004 and accepts audio mixed into the uplink on 0x8005
+ * ("incall music"). These are the virtual port indices this driver uses for
+ * them. They are kept out of include/dt-bindings on purpose: the module set is
+ * built out of tree against the shipped kernel headers, so device trees refer
+ * to them by number.
+ */
+#ifndef __Q6AFE_PSEUDO_PORTS_H__
+#define __Q6AFE_PSEUDO_PORTS_H__
+
+#define VOICE_RECORD_RX		136	/* call downlink (far end), DSP -> host */
+#define VOICE_RECORD_TX		137	/* call uplink (near end), DSP -> host */
+#define VOICE_PLAYBACK_TX	138	/* host -> mixed into call uplink */
+
+#endif /* __Q6AFE_PSEUDO_PORTS_H__ */
