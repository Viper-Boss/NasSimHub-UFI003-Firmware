+void q6voice_set_volte(struct q6voice *v, bool volte)
+{
+	v->volte = volte;
+}
+EXPORT_SYMBOL_GPL(q6voice_set_volte);
+
+bool q6voice_get_volte(struct q6voice *v)
+{
+	return v->volte;
+}
+EXPORT_SYMBOL_GPL(q6voice_get_volte);
+
+int q6voice_set_record(struct q6voice *v, enum q6voice_path_type path,
+		       bool rx, bool tx)
+{
+	struct q6voice_path *p = &v->paths[path];
+	int ret;
+
+	mutex_lock(&p->lock);
+	p->want_rec_rx = rx;
+	p->want_rec_tx = tx;
+	ret = q6voice_path_apply_taps(p);
+	mutex_unlock(&p->lock);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(q6voice_set_record);
+
+void q6voice_get_record(struct q6voice *v, enum q6voice_path_type path,
+			bool *rx, bool *tx)
+{
+	struct q6voice_path *p = &v->paths[path];
+
+	mutex_lock(&p->lock);
+	*rx = p->want_rec_rx;
+	*tx = p->want_rec_tx;
+	mutex_unlock(&p->lock);
+}
+EXPORT_SYMBOL_GPL(q6voice_get_record);
+
+int q6voice_set_playback(struct q6voice *v, enum q6voice_path_type path,
+			 bool enable)
+{
+	struct q6voice_path *p = &v->paths[path];
+	int ret;
+
+	mutex_lock(&p->lock);
+	p->want_playback = enable;
+	ret = q6voice_path_apply_taps(p);
+	mutex_unlock(&p->lock);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(q6voice_set_playback);
+
+bool q6voice_get_playback(struct q6voice *v, enum q6voice_path_type path)
+{
+	struct q6voice_path *p = &v->paths[path];
+	bool enable;
+
+	mutex_lock(&p->lock);
+	enable = p->want_playback;
+	mutex_unlock(&p->lock);
+	return enable;
+}
+EXPORT_SYMBOL_GPL(q6voice_get_playback);
