 /**
+ * q6afe_pseudo_port_prepare() - Prepare an in-call record/playback pseudo port
+ *
+ * @port: Instance of the afe port
+ * @cfg: Pseudo port configuration
+ *
+ * Mirrors the downstream msm-dai-q6 pseudo port setup: 16 bit linear PCM,
+ * timer driven (real time), at the rate and channel count of the stream.
+ */
+void q6afe_pseudo_port_prepare(struct q6afe_port *port,
+			       struct q6afe_pseudo_cfg *cfg)
+{
+	union afe_port_config *pcfg = &port->port_cfg;
+
+	memset(&pcfg->pseudo_cfg, 0, sizeof(pcfg->pseudo_cfg));
+	pcfg->pseudo_cfg.pseud_port_cfg_minor_version =
+					AFE_API_VERSION_PSEUDO_PORT_CONFIG;
+	pcfg->pseudo_cfg.bit_width = cfg->bit_width;
+	pcfg->pseudo_cfg.num_channels = cfg->num_channels;
+	pcfg->pseudo_cfg.data_format = 0; /* linear PCM */
+	pcfg->pseudo_cfg.timing_mode = AFE_PSEUDOPORT_TIMING_MODE_TIMER;
+	pcfg->pseudo_cfg.sample_rate = cfg->sample_rate;
+}
+EXPORT_SYMBOL_GPL(q6afe_pseudo_port_prepare);
