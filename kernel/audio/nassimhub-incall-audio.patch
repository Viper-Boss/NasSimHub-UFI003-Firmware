+/*
+ * In-call audio for hosts without a codec on the voice path (NasSimHub UFI003).
+ *
+ *   "Voice Session VoLTE"    attach to the VoLTE rather than the CS session
+ *   "Voice Record Downlink"  deliver the far end on VOICE_RECORD_RX (0x8003)
+ *   "Voice Record Uplink"    deliver the near end on VOICE_RECORD_TX (0x8004)
+ *   "Voice Playback Uplink"  mix VOICE_PLAYBACK_TX (0x8005) into the uplink
+ *
+ * The record/playback switches may be set before or during a call; they are
+ * applied whenever the CS-VOICE path is running.
+ */
+enum {
+	Q6VOICE_CTL_VOLTE,
+	Q6VOICE_CTL_REC_RX,
+	Q6VOICE_CTL_REC_TX,
+	Q6VOICE_CTL_PLAYBACK,
+};
+
+static int q6voice_get_tap(struct snd_kcontrol *kcontrol,
+			   struct snd_ctl_elem_value *ucontrol)
+{
+	struct snd_soc_component *c = snd_soc_kcontrol_component(kcontrol);
+	struct soc_mixer_control *mc =
+		(struct soc_mixer_control *)kcontrol->private_value;
+	struct q6voice *v = snd_soc_component_get_drvdata(c);
+	bool rx, tx;
+
+	switch (mc->shift) {
+	case Q6VOICE_CTL_VOLTE:
+		ucontrol->value.integer.value[0] = q6voice_get_volte(v);
+		break;
+	case Q6VOICE_CTL_REC_RX:
+	case Q6VOICE_CTL_REC_TX:
+		q6voice_get_record(v, Q6VOICE_PATH_VOICE, &rx, &tx);
+		ucontrol->value.integer.value[0] =
+			mc->shift == Q6VOICE_CTL_REC_RX ? rx : tx;
+		break;
+	case Q6VOICE_CTL_PLAYBACK:
+		ucontrol->value.integer.value[0] =
+			q6voice_get_playback(v, Q6VOICE_PATH_VOICE);
+		break;
+	default:
+		return -EINVAL;
+	}
+	return 0;
+}
+
+static int q6voice_put_tap(struct snd_kcontrol *kcontrol,
+			   struct snd_ctl_elem_value *ucontrol)
+{
+	struct snd_soc_component *c = snd_soc_kcontrol_component(kcontrol);
+	struct soc_mixer_control *mc =
+		(struct soc_mixer_control *)kcontrol->private_value;
+	struct q6voice *v = snd_soc_component_get_drvdata(c);
+	bool val = !!ucontrol->value.integer.value[0];
+	bool rx, tx, old;
+	int ret = 0;
+
+	switch (mc->shift) {
+	case Q6VOICE_CTL_VOLTE:
+		old = q6voice_get_volte(v);
+		q6voice_set_volte(v, val);
+		return old != val;
+	case Q6VOICE_CTL_REC_RX:
+	case Q6VOICE_CTL_REC_TX:
+		q6voice_get_record(v, Q6VOICE_PATH_VOICE, &rx, &tx);
+		old = mc->shift == Q6VOICE_CTL_REC_RX ? rx : tx;
+		if (mc->shift == Q6VOICE_CTL_REC_RX)
+			rx = val;
+		else
+			tx = val;
+		ret = q6voice_set_record(v, Q6VOICE_PATH_VOICE, rx, tx);
+		break;
+	case Q6VOICE_CTL_PLAYBACK:
+		old = q6voice_get_playback(v, Q6VOICE_PATH_VOICE);
+		ret = q6voice_set_playback(v, Q6VOICE_PATH_VOICE, val);
+		break;
+	default:
+		return -EINVAL;
+	}
+	if (ret)
+		return ret;
+	return old != val;
+}
+
+static const struct snd_kcontrol_new q6voice_tap_controls[] = {
+	SOC_SINGLE_EXT("Voice Session VoLTE", SND_SOC_NOPM, Q6VOICE_CTL_VOLTE,
+		       1, 0, q6voice_get_tap, q6voice_put_tap),
+	SOC_SINGLE_EXT("Voice Record Downlink", SND_SOC_NOPM, Q6VOICE_CTL_REC_RX,
+		       1, 0, q6voice_get_tap, q6voice_put_tap),
+	SOC_SINGLE_EXT("Voice Record Uplink", SND_SOC_NOPM, Q6VOICE_CTL_REC_TX,
+		       1, 0, q6voice_get_tap, q6voice_put_tap),
+	SOC_SINGLE_EXT("Voice Playback Uplink", SND_SOC_NOPM, Q6VOICE_CTL_PLAYBACK,
+		       1, 0, q6voice_get_tap, q6voice_put_tap),
+};
+
 static const struct snd_soc_dapm_widget q6voice_dapm_widgets[] = {
 	SND_SOC_DAPM_AIF_IN("CS-VOICE_DL1", "CS-VOICE Playback", 0, SND_SOC_NOPM, 0, 0),
 	SND_SOC_DAPM_AIF_OUT("CS-VOICE_UL1", "CS-VOICE Capture", 0, SND_SOC_NOPM, 0, 0),
@@ -209,6 +305,8 @@
