+static const char *q6voice_session_name(struct q6voice_path *p)
+{
+	return p->v->volte ? "default volte voice" : "default modem voice";
+}
+
+/* Bring the DSP record/playback state in line with what userspace asked for. */
+static int q6voice_path_apply_taps(struct q6voice_path *p)
+{
+	struct q6voice_path_runtime *rt = p->runtime;
+	struct q6voice_session *cvs;
+	int ret, err = 0;
+
+	if (!rt || rt->started != 3)
+		return 0;
+
+	cvs = rt->sessions[Q6VOICE_SERVICE_CVS];
+	if (!cvs) {
+		if (!p->want_rec_rx && !p->want_rec_tx && !p->want_playback)
+			return 0;
+		cvs = q6cvs_session_create(p->type, q6voice_session_name(p));
+		if (IS_ERR(cvs)) {
+			dev_err(p->v->dev, "failed to attach to voice stream: %ld\n",
+				PTR_ERR(cvs));
+			return PTR_ERR(cvs);
+		}
+		rt->sessions[Q6VOICE_SERVICE_CVS] = cvs;
+	}
+
+	if (p->want_rec_rx != rt->rec_rx || p->want_rec_tx != rt->rec_tx) {
+		/* The DSP takes one record configuration at a time. */
+		if (rt->rec_rx || rt->rec_tx) {
+			ret = q6cvs_record(cvs, false, false);
+			if (ret)
+				dev_warn(p->v->dev, "failed to stop record: %d\n", ret);
+			rt->rec_rx = rt->rec_tx = false;
+		}
+		if (p->want_rec_rx || p->want_rec_tx) {
+			ret = q6cvs_record(cvs, p->want_rec_rx, p->want_rec_tx);
+			if (ret) {
+				dev_err(p->v->dev, "failed to start record: %d\n", ret);
+				err = ret;
+			} else {
+				rt->rec_rx = p->want_rec_rx;
+				rt->rec_tx = p->want_rec_tx;
+			}
+		}
+	}
+
+	if (p->want_playback != rt->playback) {
+		ret = q6cvs_playback(cvs, p->want_playback);
+		if (ret) {
+			dev_err(p->v->dev, "failed to %s uplink playback: %d\n",
+				p->want_playback ? "start" : "stop", ret);
+			err = ret;
+		} else {
+			rt->playback = p->want_playback;
+		}
+	}
+
+	return err;
+}
+
+/* Stop record/playback in the DSP before the call path goes away. */
+static void q6voice_path_stop_taps(struct q6voice_path *p)
+{
+	struct q6voice_path_runtime *rt = p->runtime;
+	struct q6voice_session *cvs = rt->sessions[Q6VOICE_SERVICE_CVS];
+
+	if (!cvs)
+		return;
+	if (rt->playback && q6cvs_playback(cvs, false))
+		dev_warn(p->v->dev, "failed to stop uplink playback\n");
+	if ((rt->rec_rx || rt->rec_tx) && q6cvs_record(cvs, false, false))
+		dev_warn(p->v->dev, "failed to stop record\n");
+	rt->playback = rt->rec_rx = rt->rec_tx = false;
+}
