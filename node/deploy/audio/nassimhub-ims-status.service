[Unit]
Description=NasSimHub read-only IMS registration probe
After=ModemManager.service

[Service]
Type=oneshot
User=root
RuntimeDirectory=nassimhub-ims
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
ExecStart=/usr/lib/nassimhub/query-ims-status
TimeoutStartSec=12
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/run/nassimhub-ims
PrivateTmp=yes
