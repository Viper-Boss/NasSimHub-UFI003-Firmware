 void q6voice_set_port(struct q6voice *v, enum q6voice_path_type path,
 		      bool capture, int index);
 
+/*
+ * Which modem voice session the path attaches to. VoLTE calls run in the
+ * "default volte voice" session, circuit-switched calls in "default modem
+ * voice". Takes effect the next time the path starts.
+ */
+void q6voice_set_volte(struct q6voice *v, bool volte);
+bool q6voice_get_volte(struct q6voice *v);
+
+/* In-call record taps and uplink playback ("incall music"). */
+int q6voice_set_record(struct q6voice *v, enum q6voice_path_type path,
+		       bool rx, bool tx);
+void q6voice_get_record(struct q6voice *v, enum q6voice_path_type path,
+			bool *rx, bool *tx);
+int q6voice_set_playback(struct q6voice *v, enum q6voice_path_type path,
+			 bool enable);
+bool q6voice_get_playback(struct q6voice *v, enum q6voice_path_type path);
+
 #endif /*_Q6_VOICE_H */
