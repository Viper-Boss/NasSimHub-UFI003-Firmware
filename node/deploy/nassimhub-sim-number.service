[Unit]
Description=NasSimHub read-only SIM subscriber number probe
After=ModemManager.service

[Service]
Type=oneshot
User=root
Group=nassimhub
RuntimeDirectory=nassimhub-sim-number
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
ExecStart=/usr/bin/nassimhub-agent -probe-sim-number
TimeoutStartSec=20
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/run/nassimhub-sim-number
StandardOutput=null
